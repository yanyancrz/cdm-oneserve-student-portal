# =====================================================================
# CDM OneServe - Node notification service
#
# This file holds the VAPID PRIVATE key. It must NEVER be committed and
# must NEVER be copied into the React app.
#
#   1. cp .env.example .env
#   2. npm run keys            (generates a key pair)
#   3. paste publicKey + privateKey below
#   4. paste the SAME publicKey into ../.env  (VITE_VAPID_PUBLIC_KEY)
#                       and into ../CDM-OneServe-API/appsettings.json
#
# Losing the private key means every browser subscription has to be
# re-created, so back this file up somewhere encrypted.
# =====================================================================

# ---- HTTP surface (health/metrics only; no inbound push send API) ----
PORT=4100
HOST=127.0.0.1

# ---- MySQL (same database the ASP.NET API writes to) ----
# Use a dedicated, least-privilege user if you can; SELECT on PushOutbox /
# PushSubscriptions / PushDeliveryLogs plus UPDATE + INSERT on them is all
# this service needs. It never touches users or any business table.
DB_HOST=localhost
DB_PORT=3306
DB_USER=oneserve_push
DB_PASSWORD=
DB_NAME=cdm_oneserve

# ---- VAPID (RFC 8292) ----
# Generate once, then reuse FOREVER. Rotating keys invalidates every
# existing browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# "mailto:" or "https:" identity of the sender. Push services require it
# and it is shown to users by some browsers, so use a monitored address.
VAPID_SUBJECT=mailto:cdmoneserve@gmail.com

# ---- Worker tuning ----
# How often to look for new work.
POLL_INTERVAL_MS=5000
# Rows claimed per cycle. Keep it small enough to respect push service quotas.
BATCH_SIZE=50
# Retries before a message is declared Failed. Backoff is exponential.
MAX_ATTEMPTS=6
# Drop notifications queued longer than this (stale events stop mattering).
MAX_MESSAGE_AGE_HOURS=72
# Shrink the log of delivery attempts.
DELIVERY_LOG_RETENTION_DAYS=14

LOG_LEVEL=info
